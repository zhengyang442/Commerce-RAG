# anthropic 或 openai；留空时使用只检索模式
RAG_LLM_API_STYLE=
# Anthropic 留空时使用 https://api.anthropic.com；OpenAI-compatible 必填
RAG_LLM_BASE_URL=
# 使用项目独立密钥，不要使用或复制 Claude Code / CC Switch 凭据
RAG_LLM_API_KEY=
# 模型 ID 由使用者显式配置
RAG_LLM_MODEL=
RAG_LLM_TIMEOUT_SECONDS=30
# auto 会为 DeepSeek 选择 json_object，其他 OpenAI-compatible 默认 json_schema
RAG_LLM_STRUCTURED_OUTPUT=auto
# auto 会为 DeepSeek 关闭 Thinking；也可显式设为 enabled 或 disabled
RAG_LLM_THINKING=auto
# 中文或中英混合查询是否调用已配置模型做结构化查询改写
RAG_QUERY_REWRITE_ENABLED=true
RAG_QUERY_REWRITE_TIMEOUT_SECONDS=8

# 公网预览模式：关闭 OpenAPI 文档并启用 Host、CORS、速率和请求体边界
RAG_PUBLIC_PREVIEW=false
# 逗号分隔，只填写实际个人网站或隧道来源；同域反向代理可留空
RAG_ALLOWED_ORIGINS=
# 公网映射时加入确切域名，不能使用 *
RAG_ALLOWED_HOSTS=127.0.0.1,localhost
RAG_RATE_LIMIT_PER_MINUTE=30
RAG_MAX_REQUEST_BYTES=16384
RAG_MAX_EXTERNAL_CONCURRENCY=4
